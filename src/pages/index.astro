---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { projetos } from '../data/projects-data';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
      <h1>Leonardo Bayma</h1>
      <p class="tagline">Estudante de engenharia da computação. Nas horas livres, game dev.</p>
      <p class="intro">
        Comecei mexendo com jogos e acabei me apaixonando pela computação
        como um todo. Hoje, no 3º semestre de engenharia da computação,
        construo os próprios jogos em Godot e Unity, além de manter por
        aqui um diário do que vou aprendendo pelo caminho.
      </p>

      <h2>Projetos</h2>
      <ul class="horizontal-list">
        {projetos.map((p) => (
          <li>
            <a href={p.href}>
              <strong>{p.nome}</strong>
              <p>{p.desc}</p>
            </a>
          </li>
        ))}
        <li>
          <a href="/projects" class="see-more">
            <strong>ver todos os projetos →</strong>
          </a>
        </li>
      </ul>

      <h2>Posts recentes</h2>
      <ul class="horizontal-list">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              <strong>{post.data.title}</strong>
              <FormattedDate date={post.data.pubDate} />
            </a>
          </li>
        ))}
        <li>
          <a href="/blog" class="see-more">
            <strong>ver todos os posts →</strong>
          </a>
        </li>
      </ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.horizontal-list {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		margin: 0 0 2.5rem;
		padding: 0 0 0.5rem;
		overflow-x: auto;
		overflow-y: hidden;
	}

	.horizontal-list li {
		flex: 0 0 240px;
	}

	.horizontal-list a {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		height: 100%;
		padding: 1rem;
		border: 1px solid rgba(28, 36, 48, 0.15);
		border-radius: 2px;
		background-color: rgba(242, 238, 227, 0.6);
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}

	.horizontal-list a:hover {
		border-color: var(--accent);
	}

	.horizontal-list strong {
		font-family: 'Space Grotesk', system-ui, sans-serif;
		color: rgb(var(--black));
	}

	.horizontal-list p {
		margin: 0;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.horizontal-list a.see-more {
		justify-content: center;
		align-items: center;
		text-align: center;
		border-style: dashed;
	}

	.horizontal-list a.see-more strong {
		color: var(--accent);
	}

	@media (max-width: 600px) {
		.horizontal-list li {
			flex-basis: 200px;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.horizontal-list').forEach((list) => {
		list.addEventListener('wheel', (e) => {
			if (e.deltaY === 0) return;
			e.preventDefault();
			list.scrollLeft += e.deltaY;
		}, { passive: false });
	});
</script>
